{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice.schema.json",
  "title": "Voice",
  "type": "object",
  "required": ["id", "name", "creator"],
  "additionalProperties": false,
  "properties": {
    "id":                  { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name":                { "type": "string", "minLength": 1 },
    "creator":             { "type": "string" },
    "creatorLogo":         { "type": ["string", "null"] },
    "creatorWebsite":      { "type": ["string", "null"], "format": "uri" },
    "launchDate":          { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "isNew":               { "type": "boolean", "default": false },
    "isTrending":          { "type": "boolean", "default": false },
    "buzzScore":           { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "latencyMs":           { "type": ["integer", "null"], "minimum": 0 },
    "latencyLabel":        { "type": ["string", "null"] },
    "modality":            { "type": "array", "items": { "type": "string" }, "default": [] },
    "tone":                { "type": "array", "items": { "type": "string" }, "default": [] },
    "voiceCharacter":      { "type": ["string", "null"] },
    "languageCount":       { "type": ["integer", "null"], "minimum": 0 },
    "languages":           { "type": "array", "items": { "type": "string" }, "default": [] },
    "pricing":             { "type": ["string", "null"] },
    "pricingModel":        { "type": ["string", "null"] },
    "freeCredits":         { "type": ["string", "null"] },
    "useCases":            { "type": "array", "items": { "type": "string" }, "default": [] },
    "qualityRating":       { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "naturalness":         { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "clarity":             { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "emotionRange":        { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "streamingSupport":    { "type": "boolean", "default": false },
    "voiceCloningSupport": { "type": "boolean", "default": false },
    "description":         { "type": ["string", "null"] },
    "audioSampleUrl":      { "type": ["string", "null"] },
    "demoUrl":             { "type": ["string", "null"], "format": "uri" },
    "sampleText":          { "type": ["string", "null"] },
    "tags":                { "type": "array", "items": { "type": "string" }, "default": [] },
    "compliance":          { "type": "array", "items": { "type": "string" }, "default": [] },
    "apiType":             { "type": ["string", "null"] },
    "category":            { "type": ["string", "null"] },
    "marketPosition":      { "type": ["string", "null"] },
    "trainingApproach":    { "type": ["string", "null"] },
    "bestForRegion":       { "type": ["string", "null"] },
    "codeMixedSupport":    { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
