{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitor.schema.json",
  "title": "Competitor",
  "type": "object",
  "required": ["id", "name", "category"],
  "additionalProperties": false,
  "properties": {
    "id":              { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 2, "maxLength": 64 },
    "name":            { "type": "string", "minLength": 1, "maxLength": 120 },
    "logo":            { "type": ["string", "null"], "format": "uri" },
    "category":        { "type": "string", "minLength": 1 },
    "founded":         { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
    "hq":              { "type": ["string", "null"] },
    "agentAI":         { "type": ["boolean", "null"] },
    "isRezo":          { "type": ["boolean", "null"] },
    "fundingStatus":   { "type": ["string", "null"] },
    "totalFunding":    { "type": ["string", "null"] },
    "lastRound":       { "type": ["string", "null"] },
    "lastRoundDate":   { "type": ["string", "null"] },
    "estimatedARR":    { "type": ["string", "null"] },
    "investors":       { "type": "array", "items": { "type": "string" }, "default": [] },
    "buzzScore":       { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "matchScore":      { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "description":     { "type": ["string", "null"] },
    "products": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name":        { "type": "string" },
          "description": { "type": "string" },
          "flagship":    { "type": "boolean" }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "proprietaryLLM":          { "type": "boolean" },
        "nativeDialer":            { "type": "boolean" },
        "automatedQA":             { "type": "boolean" },
        "diyBotBuilder":           { "type": "boolean" },
        "multiLingual":            { "type": "boolean" },
        "lowLatency":              { "type": "boolean" },
        "securityCertifications":  { "type": "array", "items": { "type": "string" } },
        "emotionDetection":        { "type": "boolean" },
        "realTimeTransfer":        { "type": "boolean" },
        "omniChannel":             { "type": "boolean" },
        "vernacularSupport":       { "type": "string" }
      }
    },
    "painPoints": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["issue"],
        "properties": {
          "issue":    { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "source":   { "type": "string" }
        }
      }
    },
    "analyticsMaturity": {
      "type": "object",
      "properties": {
        "baseReports": {
          "type": "object",
          "properties": {
            "callRecording": { "type": "boolean" },
            "transcription": { "type": "boolean" },
            "aht":           { "type": "boolean" }
          }
        },
        "advancedIntelligence": {
          "type": "object",
          "properties": {
            "sentimentAnalysis": { "type": "boolean" },
            "emotionDetection":  { "type": "boolean" },
            "automatedQA":       { "type": "boolean" },
            "agentCoaching":     { "type": "boolean" }
          }
        }
      }
    },
    "recentFeatures": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "launchDate"],
        "properties": {
          "name":       { "type": "string" },
          "launchDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "isNew":      { "type": "boolean" },
          "url":        { "type": "string", "format": "uri" }
        }
      }
    },
    "recentFundings": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["round", "amount", "date"],
        "properties": {
          "round":        { "type": "string" },
          "amount":       { "type": "string" },
          "date":         { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "leadInvestor": { "type": "string" },
          "isRecent":     { "type": "boolean" }
        }
      }
    },
    "industries": { "type": "array", "items": { "type": "string" }, "default": [] },
    "usps":       { "type": "array", "items": { "type": "string" }, "default": [] },
    "website":    { "type": ["string", "null"], "format": "uri" }
  }
}
